    {
      "id": "6362",
      "name": "CMARCC January Ants at RC Excitement",
      "url": "https://www.robotcombatevents.com/events/6362",
      "start_date": "01/18/2026",
      "end_date": "01/18/2026",
      "location": "Fitchburg, MA, United States",
      "bots_count": 22,
      "logo_url": "https://www.robotcombatevents.com/assets/RCELogo-3383ca77f76e5be2b7755ea9d0c464aea25a87d8c9f2a4cffd63643392f59fe7.png",
      "description": "Central Massachusetts Robot Combat Club presents our third round of monthly fights.\n\nWe will be fighting both Plastic and Full Combat Ants.  The cage is a 4x4x2 cage on a 30 inch stand.\n\nThe pits will open at 9:30 am with fights starting around 10:30.  The store closes at 5:00 PM so we need to be done by then.\n\nFor any questions contact Glenn Boxell , gboxell@verizon.net.\n\nThere will be a cap of 32 bots for the event.  Depending on the numbers of each class the total will be split between both classes.\n\nThe format will be double elimination.\n\nFee: $25. Payment will be by Venmo, @gboxell.  Please include Robot Name in payment.  Please do not select the Sales/Service.  Venmo takes a cut when you do this.",
      "competitions": [
        {
          "id": "6922",
          "name": "Full Combat Ants",
          "weight_class": "1lb - Antweight",
